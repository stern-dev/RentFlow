    function canUpdateApplication(appId) {
      let d = request.resource.data;
      let e = resource.data;
      let uid = request.auth.uid;
      let u = loadActiveUser();
      let o = loadOrg(e.orgId);
      let changed = d.diff(e).affectedKeys();
      return isSignedIn() &&
             isValidId(appId) &&
             isValidApplication(d) &&
             (
               isAdmin() ||
               (
                 d.unitId == e.unitId &&
                 d.propertyId == e.propertyId &&
                 d.orgId == e.orgId &&
                 d.ownerUid == e.ownerUid &&
                 d.applicantUid == e.applicantUid &&
                 d.managerUids == e.managerUids &&
                 d.authorizedUids == e.authorizedUids &&
                 d.createdAt == e.createdAt &&
                 isVerifiedEmail() &&
                 isActiveUserDoc(u) &&
                 (
                   (
                     'TENANT' in u.roles &&
                     e.applicantUid == uid &&
                     e.status in ['SUBMITTED', 'UNDER_REVIEW'] &&
                     d.status == 'WITHDRAWN' &&
                     changed.hasOnly(['status', 'updatedAt'])
                   ) ||
                   (
                     u.roles.hasAny(['LANDLORD', 'PROPERTY_MANAGER']) &&
                     uid in e.authorizedUids &&
                     o != null &&
                     o.suspended == false &&
                     (o.ownerUid == uid || uid in o.memberUids) &&
                     e.status in ['SUBMITTED', 'UNDER_REVIEW'] &&
                     d.status in ['UNDER_REVIEW', 'APPROVED', 'REJECTED'] &&
                     changed.hasOnly(['status', 'reviewerNotes', 'updatedAt'])
                   )
                 )
               )
             );
    }

    function canUpdateLease(leaseId) {
      let d = request.resource.data;
      let e = resource.data;
      let uid = request.auth.uid;
      let u = loadActiveUser();
      let o = loadOrg(e.orgId);
      let baseImmutable = d.orgId == e.orgId && d.propertyId == e.propertyId && d.unitId == e.unitId && d.ownerUid == e.ownerUid && d.tenantUid == e.tenantUid && d.createdAt == e.createdAt;
      let changed = d.diff(e).affectedKeys();
      return isSignedIn() &&
             isValidId(leaseId) &&
             isValidLease(d) &&
             baseImmutable &&
             (
               isAdmin() ||
               (
                 isVerifiedEmail() &&
                 isActiveUserDoc(u) &&
                 o != null &&
                 o.suspended == false &&
                 (
                   (
                     'LANDLORD' in u.roles &&
                     e.ownerUid == uid &&
                     o.ownerUid == uid &&
                     changed.hasOnly(['rentCents', 'depositCents', 'startDateEpochMs', 'endDateEpochMs', 'dueDayOfMonth', 'status', 'creditBalanceCents', 'termsSummary', 'terminationNotice', 'managerUids', 'authorizedUids', 'updatedAt'])
                   ) ||
                   (
                     u.roles.hasAny(['LANDLORD', 'PROPERTY_MANAGER']) &&
                     uid in e.authorizedUids &&
                     (o.ownerUid == uid || uid in o.memberUids) &&
                     d.rentCents == e.rentCents &&
                     d.depositCents == e.depositCents &&
                     d.managerUids == e.managerUids &&
                     d.authorizedUids == e.authorizedUids &&
                     d.status in ['ACTIVE', 'EXPIRED', 'RENEWED'] &&
                     changed.hasOnly(['startDateEpochMs', 'endDateEpochMs', 'dueDayOfMonth', 'status', 'creditBalanceCents', 'termsSummary', 'updatedAt'])
                   )
                 )
               )
             );
    }

    function canUpdateInvoice(invoiceId) {
      let d = request.resource.data;
      let e = resource.data;
      let uid = request.auth.uid;
      let u = loadActiveUser();
      let o = loadOrg(e.orgId);
      let baseImmutable = d.invoiceNumber == e.invoiceNumber && d.leaseId == e.leaseId && d.orgId == e.orgId && d.propertyId == e.propertyId && d.unitId == e.unitId && d.ownerUid == e.ownerUid && d.tenantUid == e.tenantUid && d.createdAt == e.createdAt;
      return isSignedIn() &&
             isValidId(invoiceId) &&
             isValidInvoice(d) &&
             baseImmutable &&
             (
               isAdmin() ||
               (
                 isVerifiedEmail() &&
                 isActiveUserDoc(u) &&
                 u.roles.hasAny(['LANDLORD', 'PROPERTY_MANAGER']) &&
                 uid in e.authorizedUids &&
                 o != null &&
                 o.suspended == false &&
                 (o.ownerUid == uid || uid in o.memberUids) &&
                 e.status != 'CANCELLED' &&
                 d.managerUids == e.managerUids &&
                 d.authorizedUids == e.authorizedUids &&
                 d.billingPeriod == e.billingPeriod &&
                 d.diff(e).affectedKeys().hasOnly(['paidCents', 'outstandingCents', 'status', 'extraChargesCents', 'extraChargesNote', 'totalDueCents', 'lastReminderSentEpochMs', 'reminderCount', 'updatedAt'])
               )
             );
    }

    function canCreatePayment(paymentId) {
      let d = request.resource.data;
      let uid = request.auth.uid;
      let u = loadActiveUser();
      let o = loadOrg(d.orgId);
      let leasePath = /databases/$(database)/documents/leases/$(d.leaseId);
      let lease = exists(leasePath) ? get(leasePath).data : null;
      return isValidId(paymentId) &&
             isValidPayment(d) &&
             d.recordedByUid == uid &&
             o != null &&
             o.suspended == false &&
             d.keys().hasAll(['referenceCode', 'leaseId', 'orgId', 'propertyId', 'propertyName', 'unitId', 'unitNumber', 'ownerUid', 'managerUids', 'authorizedUids', 'tenantUid', 'tenantName', 'amountCents', 'method', 'simulatedCheckout', 'paymentDateEpochMs', 'status', 'recordedByUid', 'createdAt', 'updatedAt']) &&
             d.keys().hasOnly(['referenceCode', 'leaseId', 'invoiceId', 'orgId', 'propertyId', 'propertyName', 'unitId', 'unitNumber', 'ownerUid', 'managerUids', 'authorizedUids', 'tenantUid', 'tenantName', 'amountCents', 'method', 'paymentMethodId', 'paymentChannelType', 'paymentShortcode', 'simulatedCheckout', 'paymentDateEpochMs', 'status', 'recordedByUid', 'verifiedByUid', 'verificationNotes', 'reversalReason', 'allocationsSummary', 'receiptNumber', 'verificationSource', 'matchedReceiptId', 'createdAt', 'updatedAt']) &&
             lease != null &&
             lease.orgId == d.orgId &&
             lease.propertyId == d.propertyId &&
             lease.unitId == d.unitId &&
             lease.ownerUid == d.ownerUid &&
             lease.tenantUid == d.tenantUid &&
             d.authorizedUids == lease.authorizedUids &&
             (
               isAdmin() ||
               (
                 isVerifiedEmail() &&
                 isActiveUserDoc(u) &&
                 (
                   ('TENANT' in u.roles && d.tenantUid == uid && d.status == 'PENDING_VERIFICATION') ||
                   (u.roles.hasAny(['LANDLORD', 'PROPERTY_MANAGER']) && uid in d.authorizedUids && (o.ownerUid == uid || uid in o.memberUids) && d.status in ['PENDING_VERIFICATION', 'VERIFIED'])
                 )
               )
             );
    }

    function canUpdatePayment(paymentId) {
      let d = request.resource.data;
      let e = resource.data;
      let uid = request.auth.uid;
      let u = loadActiveUser();
      let o = loadOrg(e.orgId);
      let changed = d.diff(e).affectedKeys();
      return isSignedIn() &&
             isValidId(paymentId) &&
             isValidPayment(d) &&
             (
               isAdmin() ||
               (
                 d.referenceCode == e.referenceCode &&
                 d.leaseId == e.leaseId &&
                 d.orgId == e.orgId &&
                 d.propertyId == e.propertyId &&
                 d.unitId == e.unitId &&
                 d.ownerUid == e.ownerUid &&
                 d.tenantUid == e.tenantUid &&
                 d.amountCents == e.amountCents &&
                 d.method == e.method &&
                 d.recordedByUid == e.recordedByUid &&
                 d.managerUids == e.managerUids &&
                 d.authorizedUids == e.authorizedUids &&
                 d.createdAt == e.createdAt &&
                 isVerifiedEmail() &&
                 isActiveUserDoc(u) &&
                 o != null &&
                 o.suspended == false &&
                 (
                   (
                     'LANDLORD' in u.roles &&
                     e.ownerUid == uid &&
                     o.ownerUid == uid &&
                     e.status != 'REVERSED' &&
                     changed.hasOnly(['status', 'verifiedByUid', 'verificationNotes', 'reversalReason', 'allocationsSummary', 'receiptNumber', 'verificationSource', 'matchedReceiptId', 'updatedAt'])
                   ) ||
                   (
                     u.roles.hasAny(['LANDLORD', 'PROPERTY_MANAGER']) &&
                     uid in e.authorizedUids &&
                     (o.ownerUid == uid || uid in o.memberUids) &&
                     e.status == 'PENDING_VERIFICATION' &&
                     d.status in ['VERIFIED', 'REJECTED'] &&
                     changed.hasOnly(['status', 'verifiedByUid', 'verificationNotes', 'allocationsSummary', 'receiptNumber', 'verificationSource', 'matchedReceiptId', 'updatedAt'])
                   )
                 )
               )
             );
    }

    function canUpdateExpense(expenseId) {
      let d = request.resource.data;
      let e = resource.data;
      let uid = request.auth.uid;
      let u = loadActiveUser();
      let o = loadOrg(e.orgId);
      return isSignedIn() &&
             isValidId(expenseId) &&
             isValidExpense(d) &&
             (
               isAdmin() ||
               (
                 isVerifiedEmail() &&
                 isActiveUserDoc(u) &&
                 u.roles.hasAny(['LANDLORD', 'PROPERTY_MANAGER']) &&
                 uid in e.authorizedUids &&
                 o != null &&
                 o.suspended == false &&
                 (o.ownerUid == uid || uid in o.memberUids) &&
                 d.orgId == e.orgId &&
                 d.propertyId == e.propertyId &&
                 d.ownerUid == e.ownerUid &&
                 d.recordedByUid == e.recordedByUid &&
                 d.managerUids == e.managerUids &&
                 d.authorizedUids == e.authorizedUids &&
                 d.createdAt == e.createdAt &&
                 d.diff(e).affectedKeys().hasOnly(['category', 'title', 'description', 'amountCents', 'expenseDateEpochMs', 'documentRef', 'updatedAt'])
               )
             );
    }

    function canCreateMaintenance(requestId) {
      let d = request.resource.data;
      let uid = request.auth.uid;
      let u = loadActiveUser();
      let o = loadOrg(d.orgId);
      let unitPath = /databases/$(database)/documents/units/$(d.unitId);
      let unit = exists(unitPath) ? get(unitPath).data : null;
      return isValidId(requestId) &&
             isValidMaintenance(d) &&
             d.status == 'SUBMITTED' &&
             o != null &&
             o.suspended == false &&
             d.keys().hasAll(['orgId', 'propertyId', 'propertyName', 'unitId', 'unitNumber', 'ownerUid', 'managerUids', 'authorizedUids', 'tenantUid', 'tenantName', 'title', 'description', 'category', 'priority', 'status', 'repairCostCents', 'imageRefs', 'createdAt', 'updatedAt']) &&
             d.keys().hasOnly(['orgId', 'propertyId', 'propertyName', 'unitId', 'unitNumber', 'ownerUid', 'managerUids', 'authorizedUids', 'tenantUid', 'tenantName', 'assignedStaffUid', 'assignedStaffName', 'title', 'description', 'category', 'priority', 'status', 'repairCostCents', 'imageRefs', 'latestUpdateNote', 'createdAt', 'updatedAt']) &&
             unit != null &&
             unit.orgId == d.orgId &&
             unit.propertyId == d.propertyId &&
             unit.ownerUid == d.ownerUid &&
             d.authorizedUids == unit.authorizedUids &&
             (
               isAdmin() ||
               (
                 isVerifiedEmail() &&
                 isActiveUserDoc(u) &&
                 (
                   ('TENANT' in u.roles && d.tenantUid == uid) ||
                   (u.roles.hasAny(['LANDLORD', 'PROPERTY_MANAGER']) && uid in d.authorizedUids && (o.ownerUid == uid || uid in o.memberUids))
                 )
               )
             );
    }

    function canUpdateMaintenance(requestId) {
      let d = request.resource.data;
      let e = resource.data;
      let uid = request.auth.uid;
      let u = loadActiveUser();
      let o = loadOrg(e.orgId);
      let changed = d.diff(e).affectedKeys();
      return isSignedIn() &&
             isValidId(requestId) &&
             isValidMaintenance(d) &&
             (
               isAdmin() ||
               (
                 d.orgId == e.orgId &&
                 d.propertyId == e.propertyId &&
                 d.unitId == e.unitId &&
                 d.ownerUid == e.ownerUid &&
                 d.tenantUid == e.tenantUid &&
                 d.managerUids == e.managerUids &&
                 d.authorizedUids == e.authorizedUids &&
                 d.title == e.title &&
                 d.category == e.category &&
                 d.priority == e.priority &&
                 d.createdAt == e.createdAt &&
                 isVerifiedEmail() &&
                 isActiveUserDoc(u) &&
                 (
                   (
                     'TENANT' in u.roles &&
                     e.tenantUid == uid &&
                     !(e.status in ['COMPLETED', 'REJECTED']) &&
                     d.status == e.status &&
                     changed.hasOnly(['description', 'imageRefs', 'latestUpdateNote', 'updatedAt'])
                   ) ||
                   (
                     'MAINTENANCE_STAFF' in u.roles &&
                     e.assignedStaffUid == uid &&
                     o != null &&
                     o.suspended == false &&
                     !(e.status in ['COMPLETED', 'REJECTED']) &&
                     d.status in ['IN_PROGRESS', 'COMPLETED'] &&
                     changed.hasOnly(['status', 'repairCostCents', 'latestUpdateNote', 'updatedAt'])
                   ) ||
                   (
                     u.roles.hasAny(['LANDLORD', 'PROPERTY_MANAGER']) &&
                     uid in e.authorizedUids &&
                     o != null &&
                     o.suspended == false &&
                     (o.ownerUid == uid || uid in o.memberUids) &&
                     changed.hasOnly(['assignedStaffUid', 'assignedStaffName', 'status', 'repairCostCents', 'latestUpdateNote', 'updatedAt'])
                   )
                 )
               )
             );
    }

    // 5. Collection Rules
    match /admins/{userId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(userId);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && ((isVerifiedEmail() && request.auth.uid == userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedEmail() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(request.resource.data) &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.email.lower() == tokenEmailLower() &&
                       request.resource.data.suspended == false &&
                       (isAdmin() || (!('ADMIN' in request.resource.data.roles) && request.resource.data.activeRole != 'ADMIN')) &&
                       request.resource.data.keys().hasAll(['userId', 'fullName', 'email', 'roles', 'activeRole', 'notifyRentDue', 'notifyMaintenance', 'notifyAnnouncements', 'suspended', 'createdAt', 'updatedAt']) &&
                       request.resource.data.keys().hasOnly(['userId', 'fullName', 'email', 'phoneNumber', 'idNumber', 'emergencyContactName', 'emergencyContactPhone', 'roles', 'activeRole', 'activeOrgId', 'lastAcceptedInviteId', 'notifyRentDue', 'notifyMaintenance', 'notifyAnnouncements', 'suspended', 'createdAt', 'updatedAt']);
      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(request.resource.data) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.email == resource.data.email &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       (
                         isAdmin() ||
                         (
                           isVerifiedEmail() &&
                           request.auth.uid == userId &&
                           resource.data.suspended == false &&
                           request.resource.data.suspended == resource.data.suspended &&
                           request.resource.data.roles == resource.data.roles &&
                           request.resource.data.activeRole in resource.data.roles &&
                           !('ADMIN' in request.resource.data.roles) &&
                           request.resource.data.activeRole != 'ADMIN' &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phoneNumber', 'idNumber', 'emergencyContactName', 'emergencyContactPhone', 'activeRole', 'activeOrgId', 'notifyRentDue', 'notifyMaintenance', 'notifyAnnouncements', 'updatedAt'])
                         ) ||
                         isValidRoleInviteAcceptance(userId, resource.data, request.resource.data)
                       );
      allow delete: if isSignedIn() && isValidId(userId) && ((isVerifiedEmail() && request.auth.uid == userId) || isAdmin());

      match /fcm_tokens/{tokenId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(tokenId) && ((isVerifiedEmail() && request.auth.uid == userId) || isAdmin());
        allow list: if isSignedIn() && isValidId(userId) && ((isVerifiedEmail() && request.auth.uid == userId) || isAdmin());
        allow create: if isVerifiedEmail() &&
                         isValidId(userId) &&
                         isValidId(tokenId) &&
                         request.auth.uid == userId &&
                         isValidFcmToken(request.resource.data) &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.keys().hasAll(['userId', 'token', 'platform', 'notifyMaintenance', 'activeRole', 'createdAt', 'updatedAt']) &&
                         request.resource.data.keys().hasOnly(['userId', 'token', 'platform', 'notifyMaintenance', 'notifyRentDue', 'activeRole', 'appVersion', 'createdAt', 'updatedAt']);
        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(tokenId) &&
                         isValidFcmToken(request.resource.data) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         (
                           isAdmin() ||
                           (
                             isVerifiedEmail() &&
                             request.auth.uid == userId &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['token', 'platform', 'notifyMaintenance', 'notifyRentDue', 'activeRole', 'appVersion', 'updatedAt'])
                           )
                         );
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(tokenId) && ((isVerifiedEmail() && request.auth.uid == userId) || isAdmin());
      }

      match /saved_units/{unitId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(unitId) && ((isVerifiedEmail() && request.auth.uid == userId) || isAdmin());
        allow list: if isSignedIn() && isValidId(userId) && ((isVerifiedEmail() && request.auth.uid == userId) || isAdmin());
        allow create: if isVerifiedEmail() &&
                         isValidId(userId) &&
                         isValidId(unitId) &&
                         request.auth.uid == userId &&
                         isValidSavedUnit(request.resource.data) &&
                         request.resource.data.unitId == unitId &&
                         request.resource.data.keys().hasAll(['unitId', 'propertyId', 'propertyName', 'unitNumber', 'rentCents', 'savedAt']) &&
                         request.resource.data.keys().hasOnly(['unitId', 'propertyId', 'propertyName', 'unitNumber', 'rentCents', 'savedAt']);
        allow update: if false;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(unitId) && ((isVerifiedEmail() && request.auth.uid == userId) || isAdmin());
      }

      match /payment_methods/{methodId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(methodId) && ((isVerifiedEmail() && request.auth.uid == userId) || isAdmin());
        allow list: if isSignedIn() && isValidId(userId) && ((isVerifiedEmail() && request.auth.uid == userId) || isAdmin());
        allow create: if isVerifiedEmail() &&
                         isValidId(userId) &&
                         isValidId(methodId) &&
                         request.auth.uid == userId &&
                         isValidSavedPaymentMethod(request.resource.data) &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.keys().hasAll(['userId', 'label', 'channelType', 'roleScope', 'defaultMethod', 'smsVerified', 'createdAt', 'updatedAt']) &&
                         request.resource.data.keys().hasOnly(['userId', 'label', 'channelType', 'roleScope', 'paybillNumber', 'accountReference', 'tillNumber', 'phoneNumber', 'bankName', 'bankAccountNumber', 'defaultMethod', 'smsVerified', 'smsSampleRef', 'createdAt', 'updatedAt']);
        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(methodId) &&
                         isValidSavedPaymentMethod(request.resource.data) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         (
                           isAdmin() ||
                           (
                             isVerifiedEmail() &&
                             request.auth.uid == userId &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label', 'channelType', 'roleScope', 'paybillNumber', 'accountReference', 'tillNumber', 'phoneNumber', 'bankName', 'bankAccountNumber', 'defaultMethod', 'smsVerified', 'smsSampleRef', 'updatedAt'])
                           )
                         );
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(methodId) && ((isVerifiedEmail() && request.auth.uid == userId) || isAdmin());
      }

      match /mpesa_receipts/{receiptId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(receiptId) && ((isVerifiedEmail() && request.auth.uid == userId) || isAdmin());
        allow list: if isSignedIn() && isValidId(userId) && ((isVerifiedEmail() && request.auth.uid == userId) || isAdmin());
        allow create: if isVerifiedEmail() &&
                         isValidId(userId) &&
                         isValidId(receiptId) &&
                         request.auth.uid == userId &&
                         isValidMpesaReceipt(request.resource.data) &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.keys().hasAll(['userId', 'transactionCode', 'amountCents', 'direction', 'captureSource', 'status', 'rawSnippet', 'transactionTimestampMs', 'createdAt', 'updatedAt']) &&
                         request.resource.data.keys().hasOnly(['userId', 'transactionCode', 'amountCents', 'direction', 'counterpartyName', 'counterpartyPhone', 'accountReference', 'shortcode', 'captureSource', 'status', 'matchedPaymentId', 'matchedLeaseId', 'rawSnippet', 'transactionTimestampMs', 'createdAt', 'updatedAt']);
        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(receiptId) &&
                         isValidMpesaReceipt(request.resource.data) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.transactionCode == resource.data.transactionCode &&
                         request.resource.data.amountCents == resource.data.amountCents &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         (
                           isAdmin() ||
                           (
                             isVerifiedEmail() &&
                             request.auth.uid == userId &&
                             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'matchedPaymentId', 'matchedLeaseId', 'captureSource', 'direction', 'counterpartyName', 'counterpartyPhone', 'accountReference', 'shortcode', 'rawSnippet', 'transactionTimestampMs', 'updatedAt'])
                           )
                         );
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(receiptId) && ((isVerifiedEmail() && request.auth.uid == userId) || isAdmin());
      }
    }

    match /organizations/{orgId} {
      allow get: if isSignedIn() && isValidId(orgId) && (
        (isActiveAccount() && (request.auth.uid == resource.data.ownerUid || request.auth.uid in resource.data.memberUids)) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        (isVerifiedEmail() && (request.auth.uid == resource.data.ownerUid || request.auth.uid in resource.data.memberUids)) ||
        isAdmin()
      );
      allow create: if isValidId(orgId) &&
                       isValidOrganization(request.resource.data) &&
                       (hasVerifiedRole('LANDLORD') || isAdmin()) &&
                       request.resource.data.ownerUid == request.auth.uid &&
                       request.auth.uid in request.resource.data.memberUids &&
                       request.resource.data.suspended == false &&
                       (
                         isAdmin() ||
                         (
                           (!('verified' in request.resource.data) || request.resource.data.verified == false) &&
                           !('verifiedAtEpochMs' in request.resource.data) &&
                           !('verifiedByUid' in request.resource.data)
                         )
                       ) &&
                       request.resource.data.keys().hasAll(['name', 'ownerUid', 'country', 'currency', 'defaultDueDay', 'memberUids', 'suspended', 'createdAt', 'updatedAt']) &&
                       request.resource.data.keys().hasOnly(['name', 'ownerUid', 'country', 'currency', 'defaultDueDay', 'memberUids', 'suspended', 'verified', 'verifiedAtEpochMs', 'verifiedByUid', 'mpesaPaybill', 'mpesaTill', 'createdAt', 'updatedAt']);
      allow update: if isSignedIn() &&
                       isValidId(orgId) &&
                       isValidOrganization(request.resource.data) &&
                       request.resource.data.ownerUid == resource.data.ownerUid &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       (
                         isAdmin() ||
                         (
                           hasVerifiedRole('LANDLORD') &&
                           resource.data.suspended == false &&
                           resource.data.ownerUid == request.auth.uid &&
                           resource.data.ownerUid in request.resource.data.memberUids &&
                           request.resource.data.suspended == resource.data.suspended &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'country', 'currency', 'defaultDueDay', 'mpesaPaybill', 'mpesaTill', 'memberUids', 'updatedAt'])
                         ) ||
                         isInviteeJoiningOrg(orgId, resource.data, request.resource.data)
                       );
      allow delete: if isAdmin() && isValidId(orgId);
    }

    match /role_invites/{inviteId} {
      allow get: if isSignedIn() && isValidId(inviteId) && (
        isAdmin() ||
        (isActiveAccount() && (
          isOrgOwner(resource.data.orgId) ||
          resource.data.inviteeEmail == tokenEmailLower()
        ))
      );
      allow list: if isSignedIn() && (
        (isVerifiedEmail() && (
          resource.data.inviterUid == request.auth.uid ||
          resource.data.inviteeEmail == tokenEmailLower()
        )) ||
        isAdmin()
      );
      allow create: if isValidId(inviteId) &&
                       isValidRoleInvite(request.resource.data) &&
                       request.resource.data.inviterUid == request.auth.uid &&
