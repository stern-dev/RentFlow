      let u = loadActiveUser();
      let o = loadOrg(e.orgId);
      let baseImmutable = d.propertyId == e.propertyId && d.orgId == e.orgId && d.ownerUid == e.ownerUid && d.createdAt == e.createdAt;
      let changed = d.diff(e).affectedKeys();
      return isSignedIn() &&
             isValidId(unitId) &&
             isValidUnit(d) &&
             baseImmutable &&
             (
               isAdmin() ||
               (
                 isVerifiedEmail() &&
                 isActiveUserDoc(u) &&
                 o != null &&
                 o.suspended == false &&
                 (!('landlordVerified' in d) || d.landlordVerified == false || o.get('verified', false) == true) &&
                 (
                   (
                     'LANDLORD' in u.roles &&
                     e.ownerUid == uid &&
                     o.ownerUid == uid &&
                     changed.hasOnly(['unitNumber', 'unitType', 'rentCents', 'depositCents', 'status', 'amenities', 'description', 'imageRefs', 'published', 'currentTenantUid', 'currentLeaseId', 'managerUids', 'authorizedUids', 'propertyName', 'propertyCity', 'propertyCategory', 'landlordVerified', 'mpesaPaybill', 'mpesaTill', 'mpesaAccountPrefix', 'latitude', 'longitude', 'formattedAddress', 'locationVerified', 'updatedAt'])
                   ) ||
                   (
                     u.roles.hasAny(['LANDLORD', 'PROPERTY_MANAGER']) &&
                     uid in e.authorizedUids &&
                     (o.ownerUid == uid || uid in o.memberUids) &&
                     d.rentCents == e.rentCents &&
                     d.depositCents == e.depositCents &&
                     d.managerUids == e.managerUids &&
                     d.authorizedUids == e.authorizedUids &&
                     changed.hasOnly(['unitNumber', 'unitType', 'status', 'amenities', 'description', 'imageRefs', 'published', 'currentTenantUid', 'currentLeaseId', 'propertyName', 'propertyCity', 'propertyCategory', 'updatedAt'])
                   )
                 )
