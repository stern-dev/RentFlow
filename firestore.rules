rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Identity, Verification & RBAC Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return request.auth != null &&
             request.auth.token.get('email_verified', false) == true;
    }

    function tokenEmailLower() {
      return ('email' in request.auth.token && request.auth.token.email is string)
        ? request.auth.token.email.lower()
        : '';
    }

    function isValidId(id) {
      let s = id;
      return s is string && s.size() >= 1 && s.size() <= 128 && s.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(ts) {
      let t = ts;
      return t is timestamp && t <= request.time;
    }

    function isAdmin() {
      return isVerifiedEmail() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        ('email' in request.auth.token && request.auth.token.email == 'sternomolo2@gmail.com')
      );
    }

    function isBoundedString(val, minLen, maxLen) {
      let v = val;
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    function isOptionalString(d, key, maxLen) {
      return !(key in d) || (d[key] is string && d[key].size() <= maxLen);
    }

    function isOptionalBool(d, key) {
      return !(key in d) || d[key] is bool;
    }

    function isOptionalInt(d, key, minVal, maxVal) {
      return !(key in d) || (d[key] is int && d[key] >= minVal && d[key] <= maxVal);
    }

    function isOptionalNumberRange(d, key, minVal, maxVal) {
      return !(key in d) || ((d[key] is float || d[key] is int) && d[key] >= minVal && d[key] <= maxVal);
    }

    function isStringList(val, minSize, maxSize) {
      let v = val;
      return v is list && v.size() >= minSize && v.size() <= maxSize && (v.size() == 0 || v[0] is string);
    }

    // Single-lookup profile & organization loaders (never call in allow list!)
    function loadActiveUser() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(p) ? get(p).data : null;
    }

    function isActiveUserDoc(u) {
      return u != null && u.suspended == false;
    }

    function isActiveAccount() {
      let u = loadActiveUser();
      return isVerifiedEmail() && isActiveUserDoc(u);
    }

    function hasVerifiedRole(role) {
      let u = loadActiveUser();
      return isVerifiedEmail() && isActiveUserDoc(u) && role in u.roles;
    }

    function hasAnyVerifiedRole(allowedRoles) {
      let u = loadActiveUser();
      return isVerifiedEmail() && isActiveUserDoc(u) && u.roles.hasAny(allowedRoles);
    }

    function loadOrg(orgId) {
      let p = /databases/$(database)/documents/organizations/$(orgId);
      return exists(p) ? get(p).data : null;
    }

    function orgActive(orgId) {
      let o = loadOrg(orgId);
      return o != null && o.suspended == false;
    }

    function isOrgOwner(orgId) {
      let o = loadOrg(orgId);
      return isSignedIn() && o != null && o.ownerUid == request.auth.uid;
    }

    function isActiveOrgOwner(orgId) {
      let o = loadOrg(orgId);
      return isSignedIn() && o != null && o.suspended == false && o.ownerUid == request.auth.uid;
    }

    function isOrgMember(orgId) {
      let o = loadOrg(orgId);
      return isSignedIn() && o != null && (o.ownerUid == request.auth.uid || request.auth.uid in o.memberUids);
    }

    function isActiveOrgMember(orgId) {
      let o = loadOrg(orgId);
      return isSignedIn() && o != null && o.suspended == false && (o.ownerUid == request.auth.uid || request.auth.uid in o.memberUids);
    }

    function canReadOrgScopedRecord(e) {
      let u = loadActiveUser();
      let o = loadOrg(e.orgId);
      return isVerifiedEmail() &&
             isActiveUserDoc(u) &&
             u.roles.hasAny(['LANDLORD', 'PROPERTY_MANAGER']) &&
             request.auth.uid in e.authorizedUids &&
             o != null &&
             (o.ownerUid == request.auth.uid || request.auth.uid in o.memberUids);
    }

    function canReadTenantOrOrgRecord(e, tenantUidVal) {
      let u = loadActiveUser();
      let uid = request.auth.uid;
      return isVerifiedEmail() &&
             isActiveUserDoc(u) &&
             (
               ('TENANT' in u.roles && tenantUidVal == uid) ||
               (
                 u.roles.hasAny(['LANDLORD', 'PROPERTY_MANAGER']) &&
                 uid in e.authorizedUids &&
                 isOrgMember(e.orgId)
               )
             );
    }

    function canReadMaintenance(e) {
      let u = loadActiveUser();
      let uid = request.auth.uid;
      return isVerifiedEmail() &&
             isActiveUserDoc(u) &&
             (
               ('TENANT' in u.roles && e.tenantUid == uid) ||
               ('MAINTENANCE_STAFF' in u.roles && e.assignedStaffUid == uid) ||
               (
                 u.roles.hasAny(['LANDLORD', 'PROPERTY_MANAGER']) &&
                 uid in e.authorizedUids &&
                 isOrgMember(e.orgId)
               )
             );
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data) {
      let d = data;
      return isBoundedString(d.userId, 1, 128) &&
             isBoundedString(d.fullName, 1, 100) &&
             isBoundedString(d.email, 3, 150) &&
             isOptionalString(d, 'phoneNumber', 30) &&
             isOptionalString(d, 'idNumber', 40) &&
             isOptionalString(d, 'emergencyContactName', 100) &&
             isOptionalString(d, 'emergencyContactPhone', 30) &&
             isOptionalString(d, 'activeOrgId', 128) &&
             isOptionalString(d, 'lastAcceptedInviteId', 128) &&
             isStringList(d.roles, 1, 5) &&
             d.roles.hasOnly(['LANDLORD', 'PROPERTY_MANAGER', 'TENANT', 'MAINTENANCE_STAFF', 'ADMIN']) &&
             d.activeRole in ['LANDLORD', 'PROPERTY_MANAGER', 'TENANT', 'MAINTENANCE_STAFF', 'ADMIN'] &&
             d.activeRole in d.roles &&
             d.notifyRentDue is bool &&
             d.notifyMaintenance is bool &&
             d.notifyAnnouncements is bool &&
             d.suspended is bool &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidFcmToken(data) {
      let d = data;
      return isBoundedString(d.userId, 1, 128) &&
             isBoundedString(d.token, 10, 512) &&
             d.platform == 'ANDROID' &&
             d.notifyMaintenance is bool &&
             (!('notifyRentDue' in d) || d.notifyRentDue is bool) &&
             d.activeRole in ['LANDLORD', 'PROPERTY_MANAGER', 'TENANT', 'MAINTENANCE_STAFF', 'ADMIN'] &&
             isOptionalString(d, 'appVersion', 40) &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidSavedUnit(data) {
      let d = data;
      return isBoundedString(d.unitId, 1, 128) &&
             isBoundedString(d.propertyId, 1, 128) &&
             isBoundedString(d.propertyName, 1, 120) &&
             isBoundedString(d.unitNumber, 1, 40) &&
             d.rentCents is int && d.rentCents > 0 && d.rentCents <= 1000000000 &&
             isValidTimestamp(d.savedAt);
    }

    function isValidSavedPaymentMethod(data) {
      let d = data;
      return isBoundedString(d.userId, 1, 128) &&
             isBoundedString(d.label, 2, 60) &&
             d.channelType in ['MPESA_PAYBILL', 'MPESA_TILL', 'MPESA_STK', 'BANK_TRANSFER', 'CASH'] &&
             d.roleScope in ['ALL', 'TENANT', 'LANDLORD'] &&
             isOptionalString(d, 'paybillNumber', 20) &&
             isOptionalString(d, 'accountReference', 24) &&
             isOptionalString(d, 'tillNumber', 20) &&
             isOptionalString(d, 'phoneNumber', 20) &&
             isOptionalString(d, 'bankName', 60) &&
             isOptionalString(d, 'bankAccountNumber', 30) &&
             isOptionalString(d, 'smsSampleRef', 30) &&
             (
               d.channelType != 'MPESA_PAYBILL' ||
               ('paybillNumber' in d && d.paybillNumber is string && d.paybillNumber.matches('^[1-9][0-9]{4,6}$') &&
                'accountReference' in d && isBoundedString(d.accountReference, 1, 24))
             ) &&
             (
               d.channelType != 'MPESA_TILL' ||
               ('tillNumber' in d && d.tillNumber is string && d.tillNumber.matches('^[1-9][0-9]{4,6}$'))
             ) &&
             (
               d.channelType != 'MPESA_STK' ||
               ('phoneNumber' in d && d.phoneNumber is string && d.phoneNumber.matches('^(\\+254|254|0)[17][0-9]{8}$'))
             ) &&
             (
               d.channelType != 'BANK_TRANSFER' ||
               ('bankName' in d && isBoundedString(d.bankName, 2, 60) &&
                'bankAccountNumber' in d && isBoundedString(d.bankAccountNumber, 6, 30))
             ) &&
             d.defaultMethod is bool &&
             d.smsVerified is bool &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidMpesaReceipt(data) {
      let d = data;
      return isBoundedString(d.userId, 1, 128) &&
             d.transactionCode is string &&
             d.transactionCode.matches('^[A-Z0-9]{10}$') &&
             d.amountCents is int && d.amountCents > 0 && d.amountCents <= 1000000000 &&
             d.direction in ['INCOMING_RECEIVED', 'OUTGOING_SENT', 'UNKNOWN'] &&
             isOptionalString(d, 'counterpartyName', 100) &&
             isOptionalString(d, 'counterpartyPhone', 24) &&
             isOptionalString(d, 'accountReference', 40) &&
             isOptionalString(d, 'shortcode', 24) &&
             d.captureSource in ['NOTIFICATION', 'SHARE_INTENT', 'MANUAL_PASTE'] &&
             d.status in ['STAGED', 'RECONCILED', 'DISMISSED'] &&
             isOptionalString(d, 'matchedPaymentId', 128) &&
             isOptionalString(d, 'matchedLeaseId', 128) &&
             isBoundedString(d.rawSnippet, 4, 240) &&
             d.transactionTimestampMs is int && d.transactionTimestampMs > 0 &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidRoleInvite(data) {
      let d = data;
      return isBoundedString(d.orgId, 1, 128) &&
             isBoundedString(d.orgName, 2, 120) &&
             isStringList(d.propertyIds, 0, 20) &&
             isBoundedString(d.inviterUid, 1, 128) &&
             isBoundedString(d.inviterName, 1, 100) &&
             isBoundedString(d.inviteeEmail, 3, 150) &&
             d.role in ['LANDLORD', 'PROPERTY_MANAGER', 'TENANT', 'MAINTENANCE_STAFF'] &&
             d.status in ['PENDING', 'ACCEPTED', 'DECLINED', 'REVOKED'] &&
             isOptionalString(d, 'acceptedByUid', 128) &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidRoleInviteAcceptance(userId, existingData, incomingData) {
      let e = existingData;
      let d = incomingData;
      let invPath = /databases/$(database)/documents/role_invites/$(d.lastAcceptedInviteId);
      let inv = exists(invPath) ? get(invPath).data : null;
      let invAfter = getAfter(invPath).data;
      return isVerifiedEmail() &&
             request.auth.uid == userId &&
             e.suspended == false &&
             'lastAcceptedInviteId' in d &&
             isValidId(d.lastAcceptedInviteId) &&
             inv != null &&
             inv.status == 'PENDING' &&
             inv.inviteeEmail == tokenEmailLower() &&
             orgActive(inv.orgId) &&
             invAfter.status == 'ACCEPTED' &&
             invAfter.acceptedByUid == request.auth.uid &&
             d.suspended == e.suspended &&
             !('ADMIN' in d.roles) &&
             d.activeRole != 'ADMIN' &&
             d.activeRole in d.roles &&
             (
               (inv.role in e.roles && d.roles == e.roles) ||
               (d.roles.hasAll(e.roles) && d.roles.size() == e.roles.size() + 1 && inv.role in d.roles)
             ) &&
             d.diff(e).affectedKeys().hasOnly(['roles', 'activeRole', 'activeOrgId', 'lastAcceptedInviteId', 'updatedAt']);
    }

    function isInviteeJoiningOrg(orgId, existingData, incomingData) {
      let e = existingData;
      let d = incomingData;
      let userAfter = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let invPath = /databases/$(database)/documents/role_invites/$(userAfter.lastAcceptedInviteId);
      let inv = exists(invPath) ? get(invPath).data : null;
      let invAfter = getAfter(invPath).data;
      return isActiveAccount() &&
             e.suspended == false &&
             'lastAcceptedInviteId' in userAfter &&
             isValidId(userAfter.lastAcceptedInviteId) &&
             inv != null &&
             inv.orgId == orgId &&
             inv.status == 'PENDING' &&
             invAfter.status == 'ACCEPTED' &&
             invAfter.acceptedByUid == request.auth.uid &&
             d.suspended == e.suspended &&
             d.memberUids.hasAll(e.memberUids) &&
             request.auth.uid in d.memberUids &&
             d.memberUids.size() <= e.memberUids.size() + 1 &&
             d.diff(e).affectedKeys().hasOnly(['memberUids', 'updatedAt']);
    }

    function isValidOrganization(data) {
      let d = data;
      return isBoundedString(d.name, 2, 120) &&
             isBoundedString(d.ownerUid, 1, 128) &&
             isBoundedString(d.country, 2, 60) &&
             isBoundedString(d.currency, 3, 6) &&
             d.defaultDueDay is int && d.defaultDueDay >= 1 && d.defaultDueDay <= 28 &&
             isStringList(d.memberUids, 1, 25) &&
             d.suspended is bool &&
             isOptionalBool(d, 'verified') &&
             isOptionalInt(d, 'verifiedAtEpochMs', 0, 9999999999999) &&
             isOptionalString(d, 'verifiedByUid', 128) &&
             isOptionalString(d, 'mpesaPaybill', 20) &&
             isOptionalString(d, 'mpesaTill', 20) &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidProperty(data) {
      let d = data;
      return isBoundedString(d.orgId, 1, 128) &&
             isBoundedString(d.ownerUid, 1, 128) &&
             isStringList(d.managerUids, 0, 15) &&
             isStringList(d.authorizedUids, 1, 20) &&
             d.ownerUid in d.authorizedUids &&
             isBoundedString(d.name, 2, 120) &&
             d.category in ['APARTMENTS', 'BEDSITTERS', 'RESIDENTIAL_HOUSES', 'COMMERCIAL_BUILDINGS', 'SHOPS', 'OFFICES', 'MIXED_USE'] &&
             isBoundedString(d.city, 2, 60) &&
             isOptionalString(d, 'county', 60) &&
             isBoundedString(d.neighborhood, 1, 80) &&
             isBoundedString(d.addressLine, 1, 160) &&
             isBoundedString(d.description, 0, 1000) &&
             isOptionalString(d, 'waterMeterNumber', 60) &&
             isOptionalString(d, 'electricityMeterNumber', 60) &&
             isOptionalString(d, 'notes', 1000) &&
             isStringList(d.imageRefs, 0, 6) &&
             d.archived is bool &&
             d.hasPublishedUnits is bool &&
             d.totalUnitsCount is int && d.totalUnitsCount >= 0 && d.totalUnitsCount <= 10000 &&
             d.occupiedUnitsCount is int && d.occupiedUnitsCount >= 0 && d.occupiedUnitsCount <= 10000 &&
             isOptionalBool(d, 'landlordVerified') &&
             isOptionalString(d, 'mpesaPaybill', 20) &&
             isOptionalString(d, 'mpesaTill', 20) &&
             isOptionalString(d, 'mpesaAccountPrefix', 24) &&
             isOptionalNumberRange(d, 'latitude', -90.0, 90.0) &&
             isOptionalNumberRange(d, 'longitude', -180.0, 180.0) &&
             (('latitude' in d) == ('longitude' in d)) &&
             (!('latitude' in d) || !(d.latitude == 0 && d.longitude == 0)) &&
             isOptionalString(d, 'formattedAddress', 200) &&
             isOptionalString(d, 'placeId', 160) &&
             isOptionalBool(d, 'locationVerified') &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidUnit(data) {
      let d = data;
      return isBoundedString(d.propertyId, 1, 128) &&
             isBoundedString(d.propertyName, 1, 120) &&
             isBoundedString(d.propertyCity, 1, 60) &&
             isBoundedString(d.propertyCategory, 1, 40) &&
             isBoundedString(d.orgId, 1, 128) &&
             isBoundedString(d.ownerUid, 1, 128) &&
             isStringList(d.managerUids, 0, 15) &&
             isStringList(d.authorizedUids, 1, 20) &&
             d.ownerUid in d.authorizedUids &&
             isBoundedString(d.unitNumber, 1, 40) &&
             d.unitType in ['BEDSITTER', 'SINGLE_ROOM', 'ONE_BEDROOM', 'TWO_BEDROOM', 'THREE_BEDROOM', 'COMMERCIAL', 'SHOP', 'OFFICE'] &&
             d.rentCents is int && d.rentCents > 0 && d.rentCents <= 1000000000 &&
             d.depositCents is int && d.depositCents >= 0 && d.depositCents <= 1000000000 &&
             d.status in ['AVAILABLE', 'RESERVED', 'OCCUPIED', 'UNDER_MAINTENANCE'] &&
             isStringList(d.amenities, 0, 15) &&
             isBoundedString(d.description, 0, 1000) &&
             isStringList(d.imageRefs, 0, 6) &&
             d.published is bool &&
             isOptionalString(d, 'currentTenantUid', 128) &&
             isOptionalString(d, 'currentLeaseId', 128) &&
             isOptionalBool(d, 'landlordVerified') &&
             isOptionalString(d, 'mpesaPaybill', 20) &&
             isOptionalString(d, 'mpesaTill', 20) &&
             isOptionalString(d, 'mpesaAccountPrefix', 24) &&
             isOptionalNumberRange(d, 'latitude', -90.0, 90.0) &&
             isOptionalNumberRange(d, 'longitude', -180.0, 180.0) &&
             (('latitude' in d) == ('longitude' in d)) &&
             (!('latitude' in d) || !(d.latitude == 0 && d.longitude == 0)) &&
             isOptionalString(d, 'formattedAddress', 200) &&
             isOptionalBool(d, 'locationVerified') &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidApplication(data) {
      let d = data;
      return isBoundedString(d.unitId, 1, 128) &&
             isBoundedString(d.unitNumber, 1, 40) &&
             isBoundedString(d.propertyId, 1, 128) &&
             isBoundedString(d.propertyName, 1, 120) &&
             isBoundedString(d.orgId, 1, 128) &&
             isBoundedString(d.ownerUid, 1, 128) &&
             isStringList(d.managerUids, 0, 15) &&
             isStringList(d.authorizedUids, 1, 20) &&
             isBoundedString(d.applicantUid, 1, 128) &&
             isBoundedString(d.applicantName, 1, 100) &&
             isBoundedString(d.applicantPhone, 3, 30) &&
             isOptionalString(d, 'applicantEmail', 150) &&
             isOptionalString(d, 'occupation', 100) &&
             isBoundedString(d.desiredMoveInDate, 1, 40) &&
             isOptionalString(d, 'notes', 800) &&
             isOptionalString(d, 'reviewerNotes', 800) &&
             d.status in ['SUBMITTED', 'UNDER_REVIEW', 'APPROVED', 'REJECTED', 'WITHDRAWN'] &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidLease(data) {
      let d = data;
      return isBoundedString(d.orgId, 1, 128) &&
             isBoundedString(d.propertyId, 1, 128) &&
             isBoundedString(d.propertyName, 1, 120) &&
             isBoundedString(d.unitId, 1, 128) &&
             isBoundedString(d.unitNumber, 1, 40) &&
             isBoundedString(d.ownerUid, 1, 128) &&
             isStringList(d.managerUids, 0, 15) &&
             isStringList(d.authorizedUids, 1, 20) &&
             d.ownerUid in d.authorizedUids &&
             isBoundedString(d.tenantUid, 1, 128) &&
             isBoundedString(d.tenantName, 1, 100) &&
             isBoundedString(d.tenantPhone, 3, 30) &&
             d.rentCents is int && d.rentCents > 0 && d.rentCents <= 1000000000 &&
             d.depositCents is int && d.depositCents >= 0 && d.depositCents <= 1000000000 &&
             d.startDateEpochMs is int && d.startDateEpochMs > 0 &&
             d.endDateEpochMs is int && d.endDateEpochMs >= d.startDateEpochMs &&
             d.dueDayOfMonth is int && d.dueDayOfMonth >= 1 && d.dueDayOfMonth <= 28 &&
             d.status in ['ACTIVE', 'EXPIRED', 'TERMINATED', 'RENEWED'] &&
             d.creditBalanceCents is int && d.creditBalanceCents >= 0 && d.creditBalanceCents <= 1000000000 &&
             isBoundedString(d.termsSummary, 0, 1500) &&
             isOptionalString(d, 'terminationNotice', 800) &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidInvoice(data) {
      let d = data;
      return isBoundedString(d.invoiceNumber, 3, 50) &&
             isBoundedString(d.leaseId, 1, 128) &&
             isBoundedString(d.orgId, 1, 128) &&
             isBoundedString(d.propertyId, 1, 128) &&
             isBoundedString(d.propertyName, 1, 120) &&
             isBoundedString(d.unitId, 1, 128) &&
             isBoundedString(d.unitNumber, 1, 40) &&
             isBoundedString(d.ownerUid, 1, 128) &&
             isStringList(d.managerUids, 0, 15) &&
             isStringList(d.authorizedUids, 1, 20) &&
             isBoundedString(d.tenantUid, 1, 128) &&
             isBoundedString(d.tenantName, 1, 100) &&
             d.billingPeriod is string && d.billingPeriod.matches('^[0-9]{4}-[0-9]{2}$') &&
             d.rentCents is int && d.rentCents >= 0 && d.rentCents <= 1000000000 &&
             d.extraChargesCents is int && d.extraChargesCents >= 0 && d.extraChargesCents <= 1000000000 &&
             isOptionalString(d, 'extraChargesNote', 300) &&
             d.previousBalanceCents is int && d.previousBalanceCents >= 0 && d.previousBalanceCents <= 1000000000 &&
             d.totalDueCents is int && d.totalDueCents >= 0 && d.totalDueCents <= 2000000000 &&
             d.paidCents is int && d.paidCents >= 0 && d.paidCents <= 2000000000 &&
             d.outstandingCents is int && d.outstandingCents >= 0 && d.outstandingCents <= 2000000000 &&
             d.dueDateEpochMs is int && d.dueDateEpochMs > 0 &&
             d.status in ['UNPAID', 'PARTIALLY_PAID', 'PAID', 'OVERDUE', 'CANCELLED'] &&
             isOptionalInt(d, 'lastReminderSentEpochMs', 0, 9999999999999) &&
             isOptionalInt(d, 'reminderCount', 0, 10000) &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidPayment(data) {
      let d = data;
      return isBoundedString(d.referenceCode, 3, 60) &&
             isBoundedString(d.leaseId, 1, 128) &&
             isOptionalString(d, 'invoiceId', 128) &&
             isBoundedString(d.orgId, 1, 128) &&
             isBoundedString(d.propertyId, 1, 128) &&
             isBoundedString(d.propertyName, 1, 120) &&
             isBoundedString(d.unitId, 1, 128) &&
             isBoundedString(d.unitNumber, 1, 40) &&
             isBoundedString(d.ownerUid, 1, 128) &&
             isStringList(d.managerUids, 0, 15) &&
             isStringList(d.authorizedUids, 1, 20) &&
             isBoundedString(d.tenantUid, 1, 128) &&
             isBoundedString(d.tenantName, 1, 100) &&
             d.amountCents is int && d.amountCents > 0 && d.amountCents <= 1000000000 &&
             d.method in ['MPESA', 'BANK_TRANSFER', 'CASH'] &&
             isOptionalString(d, 'paymentMethodId', 128) &&
             (!('paymentChannelType' in d) || d.paymentChannelType in ['MPESA_PAYBILL', 'MPESA_TILL', 'MPESA_STK', 'BANK_TRANSFER', 'CASH']) &&
             isOptionalString(d, 'paymentShortcode', 40) &&
             d.simulatedCheckout is bool &&
             d.paymentDateEpochMs is int && d.paymentDateEpochMs > 0 &&
             d.status in ['PENDING_VERIFICATION', 'VERIFIED', 'REJECTED', 'REVERSED'] &&
             isBoundedString(d.recordedByUid, 1, 128) &&
             isOptionalString(d, 'verifiedByUid', 128) &&
             isOptionalString(d, 'verificationNotes', 400) &&
             isOptionalString(d, 'reversalReason', 400) &&
             isOptionalString(d, 'allocationsSummary', 600) &&
             isOptionalString(d, 'receiptNumber', 60) &&
             (!('verificationSource' in d) || d.verificationSource in ['MANUAL', 'MPESA_SMS_MATCH']) &&
             isOptionalString(d, 'matchedReceiptId', 128) &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidExpense(data) {
      let d = data;
      return isBoundedString(d.orgId, 1, 128) &&
             isBoundedString(d.propertyId, 1, 128) &&
             isBoundedString(d.propertyName, 1, 120) &&
             isOptionalString(d, 'unitId', 128) &&
             isBoundedString(d.ownerUid, 1, 128) &&
             isStringList(d.managerUids, 0, 15) &&
             isStringList(d.authorizedUids, 1, 20) &&
             d.category in ['MAINTENANCE', 'REPAIRS', 'SECURITY', 'CLEANING', 'UTILITIES', 'MANAGEMENT_FEES', 'INSURANCE', 'OTHER'] &&
             isBoundedString(d.title, 2, 120) &&
             isBoundedString(d.description, 0, 600) &&
             d.amountCents is int && d.amountCents > 0 && d.amountCents <= 1000000000 &&
             d.expenseDateEpochMs is int && d.expenseDateEpochMs > 0 &&
             isOptionalString(d, 'documentRef', 300) &&
             isBoundedString(d.recordedByUid, 1, 128) &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidMaintenance(data) {
      let d = data;
      return isBoundedString(d.orgId, 1, 128) &&
             isBoundedString(d.propertyId, 1, 128) &&
             isBoundedString(d.propertyName, 1, 120) &&
             isBoundedString(d.unitId, 1, 128) &&
             isBoundedString(d.unitNumber, 1, 40) &&
             isBoundedString(d.ownerUid, 1, 128) &&
             isStringList(d.managerUids, 0, 15) &&
             isStringList(d.authorizedUids, 1, 20) &&
             isBoundedString(d.tenantUid, 1, 128) &&
             isBoundedString(d.tenantName, 1, 100) &&
             isOptionalString(d, 'assignedStaffUid', 128) &&
             isOptionalString(d, 'assignedStaffName', 100) &&
             isBoundedString(d.title, 2, 140) &&
             isBoundedString(d.description, 2, 1000) &&
             d.category in ['PLUMBING', 'ELECTRICAL', 'WATER_SUPPLY', 'DOORS_WINDOWS', 'ROOF_LEAK', 'GENERAL_REPAIR'] &&
             d.priority in ['LOW', 'MEDIUM', 'HIGH', 'URGENT'] &&
             d.status in ['SUBMITTED', 'UNDER_REVIEW', 'ASSIGNED', 'IN_PROGRESS', 'COMPLETED', 'REJECTED'] &&
             d.repairCostCents is int && d.repairCostCents >= 0 && d.repairCostCents <= 1000000000 &&
             isStringList(d.imageRefs, 0, 4) &&
             isOptionalString(d, 'latestUpdateNote', 500) &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidConversation(data) {
      let d = data;
      return isBoundedString(d.orgId, 1, 128) &&
             isBoundedString(d.propertyId, 1, 128) &&
             isBoundedString(d.propertyName, 1, 120) &&
             isOptionalString(d, 'unitNumber', 40) &&
             isStringList(d.participantUids, 1, 10) &&
             isBoundedString(d.subject, 1, 140) &&
             isBoundedString(d.lastMessagePreview, 0, 300) &&
             isBoundedString(d.lastSenderUid, 1, 128) &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidMessage(data) {
      let d = data;
      return isBoundedString(d.convId, 1, 128) &&
             isStringList(d.participantUids, 1, 10) &&
             isBoundedString(d.senderUid, 1, 128) &&
             isBoundedString(d.senderName, 1, 100) &&
             isBoundedString(d.body, 1, 1500) &&
             isStringList(d.readByUids, 1, 10) &&
             isValidTimestamp(d.createdAt);
    }

    function isValidAnnouncement(data) {
      let d = data;
      return isBoundedString(d.orgId, 1, 128) &&
             isBoundedString(d.propertyId, 1, 128) &&
             isBoundedString(d.propertyName, 1, 120) &&
             isBoundedString(d.ownerUid, 1, 128) &&
             isStringList(d.authorizedUids, 1, 20) &&
             isStringList(d.targetUids, 0, 50) &&
             isBoundedString(d.title, 2, 140) &&
             isBoundedString(d.body, 2, 1500) &&
             isBoundedString(d.authorUid, 1, 128) &&
             isBoundedString(d.authorName, 1, 100) &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidNotification(data) {
      let d = data;
      return isBoundedString(d.recipientUid, 1, 128) &&
             isBoundedString(d.senderUid, 1, 128) &&
             isBoundedString(d.orgId, 1, 128) &&
             d.type in ['INVOICE', 'PAYMENT', 'MAINTENANCE', 'LEASE', 'APPLICATION', 'ANNOUNCEMENT', 'MESSAGE'] &&
             isBoundedString(d.title, 1, 140) &&
             isBoundedString(d.body, 1, 500) &&
             isOptionalString(d, 'relatedEntityId', 128) &&
             d.read is bool &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidAuditLog(data) {
      let d = data;
      return isBoundedString(d.orgId, 1, 128) &&
             isBoundedString(d.actorUid, 1, 128) &&
             isBoundedString(d.actorName, 1, 100) &&
             isBoundedString(d.action, 2, 80) &&
             isBoundedString(d.entityType, 2, 50) &&
             isBoundedString(d.entityId, 1, 128) &&
             isBoundedString(d.details, 1, 500) &&
             isValidTimestamp(d.createdAt);
    }

    function isValidReportedIssue(data) {
      let d = data;
      return isBoundedString(d.reporterUid, 1, 128) &&
             isBoundedString(d.reporterName, 1, 100) &&
             isBoundedString(d.orgId, 1, 128) &&
             isBoundedString(d.category, 2, 60) &&
             isBoundedString(d.title, 2, 140) &&
             isBoundedString(d.description, 2, 1000) &&
             d.status in ['OPEN', 'INVESTIGATING', 'RESOLVED'] &&
             isOptionalString(d, 'adminNotes', 800) &&
             isValidTimestamp(d.createdAt) &&
             isValidTimestamp(d.updatedAt);
    }

    function isValidMoveInChecklistUpdate(d) {
      return d.propertyName is string && d.propertyName.size() > 0 && d.propertyName.size() <= 120 &&
             d.unitNumber is string && d.unitNumber.size() > 0 && d.unitNumber.size() <= 40 &&
             d.managerUids is list && d.managerUids.size() <= 15 &&
             d.authorizedUids is list && d.authorizedUids.size() >= 1 && d.authorizedUids.size() <= 20 &&
             d.ownerUid in d.authorizedUids &&
             d.tenantName is string && d.tenantName.size() > 0 && d.tenantName.size() <= 100 &&
             d.status in ['DRAFT', 'PENDING_TENANT_REVIEW', 'ACKNOWLEDGED', 'DISPUTED'] &&
             d.inspectionDateEpochMs is int && d.inspectionDateEpochMs > 0 &&
             (!('waterMeterReading' in d) || (d.waterMeterReading is string && d.waterMeterReading.size() <= 40)) &&
             (!('electricityMeterReading' in d) || (d.electricityMeterReading is string && d.electricityMeterReading.size() <= 40)) &&
             d.keysHandedOverCount is int && d.keysHandedOverCount >= 0 && d.keysHandedOverCount <= 50 &&
             d.items is list && d.items.size() >= 1 && d.items.size() <= 30 && d.items[0] is map &&
             d.imageRefs is list && d.imageRefs.size() <= 4 &&
             (!('landlordNotes' in d) || (d.landlordNotes is string && d.landlordNotes.size() <= 800)) &&
             (!('tenantResponseNote' in d) || (d.tenantResponseNote is string && d.tenantResponseNote.size() <= 800)) &&
             (!('acknowledgedAtEpochMs' in d) || (d.acknowledgedAtEpochMs is int && d.acknowledgedAtEpochMs >= 0)) &&
             (!('acknowledgedByUid' in d) || (d.acknowledgedByUid is string && d.acknowledgedByUid.size() <= 128)) &&
             d.updatedAt is timestamp && d.updatedAt <= request.time;
    }

    function isValidMoveInChecklist(d) {
      return d.leaseId is string && d.leaseId.size() > 0 &&
             d.orgId is string && d.orgId.size() > 0 &&
             d.propertyId is string && d.propertyId.size() > 0 &&
             d.unitId is string && d.unitId.size() > 0 &&
             d.ownerUid is string && d.ownerUid.size() > 0 &&
             d.tenantUid is string && d.tenantUid.size() > 0 &&
             d.createdByUid is string && d.createdByUid.size() > 0 &&
             d.createdAt is timestamp && d.createdAt <= request.time &&
             isValidMoveInChecklistUpdate(d);
    }

    function isValidDepositSettlementUpdate(d) {
      return d.propertyName is string && d.propertyName.size() > 0 && d.propertyName.size() <= 120 &&
             d.unitNumber is string && d.unitNumber.size() > 0 && d.unitNumber.size() <= 40 &&
             d.managerUids is list && d.managerUids.size() <= 15 &&
             d.authorizedUids is list && d.authorizedUids.size() >= 1 && d.authorizedUids.size() <= 20 &&
             d.ownerUid in d.authorizedUids &&
             d.tenantName is string && d.tenantName.size() > 0 && d.tenantName.size() <= 100 &&
             d.depositHeldCents is int && d.depositHeldCents >= 0 && d.depositHeldCents <= 1000000000 &&
             d.arrearsIncludedCents is int && d.arrearsIncludedCents >= 0 && d.arrearsIncludedCents <= 1000000000 &&
             d.creditAppliedCents is int && d.creditAppliedCents >= 0 && d.creditAppliedCents <= 1000000000 &&
             d.deductions is list && d.deductions.size() <= 30 && (d.deductions.size() == 0 || d.deductions[0] is map) &&
             d.deductionsTotalCents is int && d.deductionsTotalCents >= 0 && d.deductionsTotalCents <= 1000000000 &&
             d.netRefundCents is int && d.netRefundCents >= 0 && d.netRefundCents <= 2000000000 &&
             d.balanceOwedCents is int && d.balanceOwedCents >= 0 && d.balanceOwedCents <= 2000000000 &&
             (d.netRefundCents == 0 || d.balanceOwedCents == 0) &&
             (d.depositHeldCents + d.creditAppliedCents) - (d.deductionsTotalCents + d.arrearsIncludedCents) == d.netRefundCents - d.balanceOwedCents &&
             d.moveOutDateEpochMs is int && d.moveOutDateEpochMs > 0 &&
             (!('waterMeterFinal' in d) || (d.waterMeterFinal is string && d.waterMeterFinal.size() <= 40)) &&
             (!('electricityMeterFinal' in d) || (d.electricityMeterFinal is string && d.electricityMeterFinal.size() <= 40)) &&
             d.keysReturnedCount is int && d.keysReturnedCount >= 0 && d.keysReturnedCount <= 50 &&
             d.imageRefs is list && d.imageRefs.size() <= 4 &&
             d.status in ['DRAFT', 'ISSUED', 'DISPUTED', 'APPROVED', 'SETTLED'] &&
             (!('landlordNotes' in d) || (d.landlordNotes is string && d.landlordNotes.size() <= 800)) &&
             (!('tenantResponseNote' in d) || (d.tenantResponseNote is string && d.tenantResponseNote.size() <= 800)) &&
             d.refundMethod in ['MPESA', 'BANK_TRANSFER', 'CASH', 'NONE'] &&
             (!('refundReferenceCode' in d) || (d.refundReferenceCode is string && d.refundReferenceCode.size() <= 60)) &&
             (!('settledAtEpochMs' in d) || (d.settledAtEpochMs is int && d.settledAtEpochMs >= 0)) &&
             (!('settledByUid' in d) || (d.settledByUid is string && d.settledByUid.size() <= 128)) &&
             d.updatedAt is timestamp && d.updatedAt <= request.time;
    }

    function isValidDepositSettlement(d) {
      return d.leaseId is string && d.leaseId.size() > 0 &&
             d.orgId is string && d.orgId.size() > 0 &&
             d.propertyId is string && d.propertyId.size() > 0 &&
             d.unitId is string && d.unitId.size() > 0 &&
             d.ownerUid is string && d.ownerUid.size() > 0 &&
             d.tenantUid is string && d.tenantUid.size() > 0 &&
             d.createdByUid is string && d.createdByUid.size() > 0 &&
             d.createdAt is timestamp && d.createdAt <= request.time &&
             isValidDepositSettlementUpdate(d);
    }

    function canCreateMoveInChecklist(checklistId) {
      let d = request.resource.data;
      let uid = request.auth.uid;
      let lPath = /databases/$(database)/documents/leases/$(d.leaseId);
      let l = exists(lPath) ? get(lPath).data : null;
      return isValidId(checklistId) &&
             isValidMoveInChecklist(d) &&
             d.createdByUid == uid &&
             d.status in ['DRAFT', 'PENDING_TENANT_REVIEW'] &&
             !('acknowledgedAtEpochMs' in d) &&
             !('acknowledgedByUid' in d) &&
             d.keys().hasOnly(['leaseId', 'orgId', 'propertyId', 'propertyName', 'unitId', 'unitNumber', 'ownerUid', 'managerUids', 'authorizedUids', 'tenantUid', 'tenantName', 'status', 'inspectionDateEpochMs', 'waterMeterReading', 'electricityMeterReading', 'keysHandedOverCount', 'items', 'imageRefs', 'landlordNotes', 'tenantResponseNote', 'acknowledgedAtEpochMs', 'acknowledgedByUid', 'createdByUid', 'createdAt', 'updatedAt']) &&
             l != null &&
             l.orgId == d.orgId &&
             l.propertyId == d.propertyId &&
             l.unitId == d.unitId &&
             l.ownerUid == d.ownerUid &&
             l.tenantUid == d.tenantUid &&
             d.authorizedUids == l.authorizedUids &&
             (
               isAdmin() ||
               (
                 hasAnyVerifiedRole(['LANDLORD', 'PROPERTY_MANAGER']) &&
                 uid in d.authorizedUids &&
                 isActiveOrgMember(d.orgId)
               )
             );
    }

    function canUpdateMoveInChecklist(checklistId) {
      let d = request.resource.data;
      let e = resource.data;
      let uid = request.auth.uid;
      let u = loadActiveUser();
      let changed = d.diff(e).affectedKeys();
      return isValidId(checklistId) &&
             isValidMoveInChecklistUpdate(d) &&
             d.leaseId == e.leaseId &&
             d.orgId == e.orgId &&
             d.propertyId == e.propertyId &&
             d.unitId == e.unitId &&
             d.ownerUid == e.ownerUid &&
             d.tenantUid == e.tenantUid &&
             d.createdByUid == e.createdByUid &&
             d.createdAt == e.createdAt &&
             (
               isAdmin() ||
               (
                 e.status != 'ACKNOWLEDGED' &&
                 isVerifiedEmail() &&
                 isActiveUserDoc(u) &&
                 (
                   (
                     u.roles.hasAny(['LANDLORD', 'PROPERTY_MANAGER']) &&
                     uid in e.authorizedUids &&
                     isActiveOrgMember(e.orgId) &&
                     e.status in ['DRAFT', 'PENDING_TENANT_REVIEW', 'DISPUTED'] &&
                     d.status in ['DRAFT', 'PENDING_TENANT_REVIEW'] &&
                     d.managerUids == e.managerUids &&
                     d.authorizedUids == e.authorizedUids &&
                     !('acknowledgedAtEpochMs' in d) &&
                     !('acknowledgedByUid' in d) &&
                     changed.hasOnly(['inspectionDateEpochMs', 'waterMeterReading', 'electricityMeterReading', 'keysHandedOverCount', 'items', 'imageRefs', 'landlordNotes', 'status', 'updatedAt'])
                   ) ||
                   (
                     'TENANT' in u.roles &&
                     e.tenantUid == uid &&
                     e.status == 'PENDING_TENANT_REVIEW' &&
                     d.status in ['ACKNOWLEDGED', 'DISPUTED'] &&
                     changed.hasOnly(['status', 'tenantResponseNote', 'acknowledgedAtEpochMs', 'acknowledgedByUid', 'updatedAt']) &&
                     (
                       (d.status == 'ACKNOWLEDGED' && d.acknowledgedByUid == uid && d.acknowledgedAtEpochMs is int && d.acknowledgedAtEpochMs > 0) ||
                       (d.status == 'DISPUTED' && 'tenantResponseNote' in d && d.tenantResponseNote is string && d.tenantResponseNote.size() >= 3 && d.tenantResponseNote.size() <= 800 && !('acknowledgedAtEpochMs' in d) && !('acknowledgedByUid' in d))
                     )
                   )
                 )
               )
             );
    }

    function canCreateDepositSettlement(settlementId) {
      let d = request.resource.data;
      let uid = request.auth.uid;
      let lPath = /databases/$(database)/documents/leases/$(d.leaseId);
      let l = exists(lPath) ? get(lPath).data : null;
      return isValidId(settlementId) &&
             isValidDepositSettlement(d) &&
             d.createdByUid == uid &&
             d.status in ['DRAFT', 'ISSUED'] &&
             !('settledAtEpochMs' in d) &&
             !('settledByUid' in d) &&
             d.keys().hasOnly(['leaseId', 'orgId', 'propertyId', 'propertyName', 'unitId', 'unitNumber', 'ownerUid', 'managerUids', 'authorizedUids', 'tenantUid', 'tenantName', 'depositHeldCents', 'arrearsIncludedCents', 'creditAppliedCents', 'deductions', 'deductionsTotalCents', 'netRefundCents', 'balanceOwedCents', 'moveOutDateEpochMs', 'waterMeterFinal', 'electricityMeterFinal', 'keysReturnedCount', 'imageRefs', 'status', 'landlordNotes', 'tenantResponseNote', 'refundMethod', 'refundReferenceCode', 'settledAtEpochMs', 'settledByUid', 'createdByUid', 'createdAt', 'updatedAt']) &&
             l != null &&
             l.orgId == d.orgId &&
             l.propertyId == d.propertyId &&
             l.unitId == d.unitId &&
             l.ownerUid == d.ownerUid &&
             l.tenantUid == d.tenantUid &&
             d.authorizedUids == l.authorizedUids &&
             (
               isAdmin() ||
               (
                 hasAnyVerifiedRole(['LANDLORD', 'PROPERTY_MANAGER']) &&
                 uid in d.authorizedUids &&
                 isActiveOrgMember(d.orgId)
               )
             );
    }

    function canUpdateDepositSettlement(settlementId) {
      let d = request.resource.data;
      let e = resource.data;
      let uid = request.auth.uid;
      let u = loadActiveUser();
      let changed = d.diff(e).affectedKeys();
      return isValidId(settlementId) &&
             isValidDepositSettlementUpdate(d) &&
             d.leaseId == e.leaseId &&
             d.orgId == e.orgId &&
             d.propertyId == e.propertyId &&
             d.unitId == e.unitId &&
             d.ownerUid == e.ownerUid &&
             d.tenantUid == e.tenantUid &&
             d.createdByUid == e.createdByUid &&
             d.createdAt == e.createdAt &&
             (
               isAdmin() ||
               (
                 e.status != 'SETTLED' &&
                 isVerifiedEmail() &&
                 isActiveUserDoc(u) &&
                 (
                   (
                     u.roles.hasAny(['LANDLORD', 'PROPERTY_MANAGER']) &&
                     uid in e.authorizedUids &&
                     isActiveOrgMember(e.orgId) &&
                     e.status in ['DRAFT', 'ISSUED', 'DISPUTED', 'APPROVED'] &&
                     d.status in ['DRAFT', 'ISSUED', 'SETTLED'] &&
                     d.managerUids == e.managerUids &&
                     d.authorizedUids == e.authorizedUids &&
                     changed.hasOnly(['depositHeldCents', 'arrearsIncludedCents', 'creditAppliedCents', 'deductions', 'deductionsTotalCents', 'netRefundCents', 'balanceOwedCents', 'moveOutDateEpochMs', 'waterMeterFinal', 'electricityMeterFinal', 'keysReturnedCount', 'imageRefs', 'landlordNotes', 'status', 'refundMethod', 'refundReferenceCode', 'settledAtEpochMs', 'settledByUid', 'updatedAt']) &&
                     (
                       (
                         d.status == 'SETTLED' &&
                         d.settledByUid == uid &&
                         d.settledAtEpochMs is int &&
                         d.settledAtEpochMs > 0 &&
                         (d.netRefundCents == 0 || (d.refundMethod in ['MPESA', 'BANK_TRANSFER', 'CASH'] && 'refundReferenceCode' in d && d.refundReferenceCode is string && d.refundReferenceCode.size() >= 3 && d.refundReferenceCode.size() <= 60))
                       ) ||
                       (
                         d.status != 'SETTLED' &&
                         !('settledAtEpochMs' in d) &&
                         !('settledByUid' in d)
                       )
                     )
                   ) ||
                   (
                     'TENANT' in u.roles &&
                     e.tenantUid == uid &&
                     e.status == 'ISSUED' &&
                     d.status in ['APPROVED', 'DISPUTED'] &&
                     changed.hasOnly(['status', 'tenantResponseNote', 'updatedAt']) &&
                     (
                       d.status == 'APPROVED' ||
                       (d.status == 'DISPUTED' && 'tenantResponseNote' in d && d.tenantResponseNote is string && d.tenantResponseNote.size() >= 3 && d.tenantResponseNote.size() <= 800)
                     )
                   )
                 )
               )
             );
    }

    // 4. Consolidated Single-Lookup Mutation Helpers (prevents >1000 CEL expression bloat)
    function canUpdateProperty(propertyId) {
      let d = request.resource.data;
      let e = resource.data;
      let uid = request.auth.uid;
      let u = loadActiveUser();
      let o = loadOrg(e.orgId);
      let baseImmutable = d.orgId == e.orgId && d.ownerUid == e.ownerUid && d.createdAt == e.createdAt;
      let changed = d.diff(e).affectedKeys();
      return isSignedIn() &&
             isValidId(propertyId) &&
             isValidProperty(d) &&
             baseImmutable &&
             (
               isAdmin() ||
               (
                 isVerifiedEmail() &&
                 isActiveUserDoc(u) &&
                 o != null &&
                 o.suspended == false &&
                 (!('landlordVerified' in d) || d.landlordVerified == false || o.get('verified', false) == true) &&
                 (
                   (
                     'LANDLORD' in u.roles &&
                     e.ownerUid == uid &&
                     o.ownerUid == uid &&
                     changed.hasOnly(['name', 'category', 'city', 'county', 'neighborhood', 'addressLine', 'description', 'waterMeterNumber', 'electricityMeterNumber', 'notes', 'imageRefs', 'managerUids', 'authorizedUids', 'archived', 'hasPublishedUnits', 'totalUnitsCount', 'occupiedUnitsCount', 'landlordVerified', 'mpesaPaybill', 'mpesaTill', 'mpesaAccountPrefix', 'latitude', 'longitude', 'formattedAddress', 'placeId', 'locationVerified', 'updatedAt'])
                   ) ||
                   (
                     u.roles.hasAny(['LANDLORD', 'PROPERTY_MANAGER']) &&
                     uid in e.authorizedUids &&
                     (o.ownerUid == uid || uid in o.memberUids) &&
                     d.managerUids == e.managerUids &&
                     d.authorizedUids == e.authorizedUids &&
                     changed.hasOnly(['hasPublishedUnits', 'totalUnitsCount', 'occupiedUnitsCount', 'updatedAt'])
                   )
                 )
               )
             );
    }

    function canUpdateUnit(unitId) {
      let d = request.resource.data;
      let e = resource.data;
