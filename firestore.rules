                       request.resource.data.senderUid == request.auth.uid &&
                       request.resource.data.read == false &&
                       request.resource.data.keys().hasAll(['recipientUid', 'senderUid', 'orgId', 'type', 'title', 'body', 'read', 'createdAt', 'updatedAt']) &&
                       request.resource.data.keys().hasOnly(['recipientUid', 'senderUid', 'orgId', 'type', 'title', 'body', 'relatedEntityId', 'read', 'createdAt', 'updatedAt']);
      allow update: if isSignedIn() &&
                       isValidId(notifId) &&
                       isValidNotification(request.resource.data) &&
                       (
                         isAdmin() ||
                         (
                           isActiveAccount() &&
                           resource.data.recipientUid == request.auth.uid &&
                           request.resource.data.recipientUid == resource.data.recipientUid &&
                           request.resource.data.senderUid == resource.data.senderUid &&
                           request.resource.data.orgId == resource.data.orgId &&
                           request.resource.data.type == resource.data.type &&
                           request.resource.data.createdAt == resource.data.createdAt &&
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt'])
                         )
                       );
      allow delete: if isSignedIn() && isValidId(notifId) && (
        (isActiveAccount() && resource.data.recipientUid == request.auth.uid) ||
        isAdmin()
      );
    }

    match /audit_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (
        isAdmin() ||
        (isActiveAccount() && (
          resource.data.actorUid == request.auth.uid ||
          (hasVerifiedRole('LANDLORD') && isOrgOwner(resource.data.orgId))
        ))
      );
      allow list: if isSignedIn() && (
        (isVerifiedEmail() && resource.data.actorUid == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isValidId(logId) &&
                       isValidAuditLog(request.resource.data) &&
                       request.resource.data.actorUid == request.auth.uid &&
                       (
                         isAdmin() ||
                         (isActiveAccount() && (isOrgMember(request.resource.data.orgId) || request.resource.data.orgId == ('user_' + request.auth.uid)))
                       ) &&
                       request.resource.data.keys().hasAll(['orgId', 'actorUid', 'actorName', 'action', 'entityType', 'entityId', 'details', 'createdAt']) &&
                       request.resource.data.keys().hasOnly(['orgId', 'actorUid', 'actorName', 'action', 'entityType', 'entityId', 'details', 'createdAt']);
      allow update, delete: if false;
    }

    match /reported_issues/{issueId} {
      allow get: if isSignedIn() && isValidId(issueId) && (
        (isActiveAccount() && resource.data.reporterUid == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        (isVerifiedEmail() && resource.data.reporterUid == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isValidId(issueId) &&
                       isValidReportedIssue(request.resource.data) &&
                       (isActiveAccount() || isAdmin()) &&
                       request.resource.data.reporterUid == request.auth.uid &&
                       request.resource.data.status == 'OPEN' &&
                       request.resource.data.keys().hasAll(['reporterUid', 'reporterName', 'orgId', 'category', 'title', 'description', 'status', 'createdAt', 'updatedAt']) &&
                       request.resource.data.keys().hasOnly(['reporterUid', 'reporterName', 'orgId', 'category', 'title', 'description', 'status', 'adminNotes', 'createdAt', 'updatedAt']);
      allow update: if isAdmin() &&
                       isValidId(issueId) &&
                       isValidReportedIssue(request.resource.data) &&
                       request.resource.data.reporterUid == resource.data.reporterUid &&
                       request.resource.data.orgId == resource.data.orgId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminNotes', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(issueId);
    }
  }
}
