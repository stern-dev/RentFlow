    match /reported_issues/{issueId} {
      allow get: if isSignedIn() && isValidId(issueId) && (existing().reporterUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().reporterUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() &&
                       isValidId(issueId) &&
                       isValidReportedIssue(incoming()) &&
                       incoming().reporterUid == request.auth.uid &&
                       incoming().status == 'OPEN' &&
                       incoming().keys().hasAll(['reporterUid', 'reporterName', 'orgId', 'category', 'title', 'description', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['reporterUid', 'reporterName', 'orgId', 'category', 'title', 'description', 'status', 'adminNotes', 'createdAt', 'updatedAt']);
      allow update: if isAdmin() &&
                       isValidId(issueId) &&
                       isValidReportedIssue(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNotes', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(issueId);
    }
  }
}
