  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles isolated by UID."
    },
    "/users/{userId}/fcm_tokens/{tokenId}": {
      "schema": { "$ref": "#/entities/FcmDeviceToken" },
      "description": "Device FCM push registration tokens owned by the user."
    },
    "/users/{userId}/saved_units/{unitId}": {
      "schema": { "$ref": "#/entities/SavedUnit" },
      "description": "Bookmarked rental units saved by the user for comparison."
    },
    "/users/{userId}/payment_methods/{methodId}": {
      "schema": { "$ref": "#/entities/SavedPaymentMethod" },
      "description": "Saved Kenya M-Pesa Paybill, Till, STK Phone, Bank, and Cash payment channels owned by the user."
    },
    "/users/{userId}/mpesa_receipts/{receiptId}": {
      "schema": { "$ref": "#/entities/MpesaReceipt" },
      "description": "Staged and reconciled M-Pesa confirmation receipts captured for the authenticated user."
    },
    "/organizations/{orgId}": {
      "schema": { "$ref": "#/entities/Organization" },
      "description": "Organizations isolating property portfolios and staff."
    },
    "/role_invites/{inviteId}": {
      "schema": { "$ref": "#/entities/RoleInvite" },
      "description": "Organization role invitations verified by invitee email."
    },
    "/properties/{propertyId}": {
      "schema": { "$ref": "#/entities/Property" },
      "description": "Rental properties with optional public discovery flag when units are published."
    },
    "/units/{unitId}": {
      "schema": { "$ref": "#/entities/RentalUnit" },
      "description": "Rental units belonging to properties."
    },
    "/applications/{appId}": {
      "schema": { "$ref": "#/entities/RentalApplication" },
      "description": "Prospective tenant rental applications."
    },
    "/leases/{leaseId}": {
      "schema": { "$ref": "#/entities/Lease" },
      "description": "Active and historical tenancy agreements."
    },
    "/move_in_checklists/{checklistId}": {
      "schema": { "$ref": "#/entities/MoveInChecklist" },
      "description": "Move-in unit condition inspection checklists linked to tenancy leases."
    },
    "/move_in_condition_checklists/{checklistId}": {
      "schema": { "$ref": "#/entities/MoveInConditionChecklist" },
      "description": "Structured room-by-room move-in condition checklists with per-item statuses, compressed photos, and landlord/tenant remarks."
    },
    "/deposit_settlements/{settlementId}": {
      "schema": { "$ref": "#/entities/DepositSettlement" },
      "description": "Move-out inspections and itemized security deposit settlement ledgers."
    },
    "/recurring_invoices/{scheduleId}": {
      "schema": { "$ref": "#/entities/RecurringInvoiceSchedule" },
      "description": "Recurring monthly invoice schedules keyed by leaseId (grace period terms sourced strictly from leases/{leaseId})."
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Monthly rent invoices keyed by leaseId_YYYY-MM."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Centralized payment ledger with verification and reversal states."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Landlord and manager property expenses."
    },
    "/maintenance_requests/{requestId}": {
      "schema": { "$ref": "#/entities/MaintenanceRequest" },
      "description": "Tenant maintenance tickets and staff repair logs."
    },
    "/conversations/{convId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Authorized messaging threads."
    },
    "/conversations/{convId}/messages/{msgId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages within an authorized conversation."
    },
    "/announcements/{annId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Property announcements for tenants."
    },
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "In-app notifications scoped to recipientUid."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable operational and financial audit log."
    },
    "/reported_issues/{issueId}": {
      "schema": { "$ref": "#/entities/ReportedIssue" },
      "description": "Platform support/issue reports for administrators."
    },
    "/scanned_documents/{docId}": {
      "schema": { "$ref": "#/entities/ScannedDocument" },
      "description": "Unit and tenant-linked scanned lease agreements, payment receipts, expense vouchers, and ID documents."
    }
  }
